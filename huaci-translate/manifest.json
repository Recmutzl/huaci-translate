{
  "manifest_version": 3,
  "name": "划词翻译",
  "version": "0.1.0",
  "description": "选中网页文字，自动翻译成中文。支持百度翻译与 DeepSeek 双引擎切换。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://fanyi-api.baidu.com/*",
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
